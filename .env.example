# Copy this file to .env and fill in your own values.

# Flask session secret — any random string
SECRET_KEY=change-this-to-a-random-string

# Groq API key, used to power the AI Trainer chat assistant.
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default Groq model
GROQ_MODEL=llama-3.3-70b-versatile

# Google Sign-In. Get this from Google Cloud Console — see the README's
# "Set up Google Sign-In" section for the exact steps.
GOOGLE_CLIENT_ID=
